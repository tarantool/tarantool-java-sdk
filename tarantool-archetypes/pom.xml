<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.tarantool</groupId>
        <artifactId>tarantool-java-sdk</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tarantool-archetypes</artifactId>
    <packaging>pom</packaging>
    <name>Tarantool Java SDK :: Archetypes</name>
    <description>Maven Archetype templates for quick project scaffolding</description>

    <properties>
        <spotless.check.skip>true</spotless.check.skip>
        <spotless.apply.skip>true</spotless.apply.skip>
    </properties>

    <build>
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>${maven-archetype-plugin.version}</version>
            </extension>
        </extensions>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>${maven-archetype-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>${package}.BoxApiApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>tarantool-box-quickstart</module>
        <module>tarantool-crud-quickstart</module>
    </modules>
</project>
