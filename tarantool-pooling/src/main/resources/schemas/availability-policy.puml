interface io.tarantool.core.state.Event {
  + boolean isControl() <<default: false>>
}

interface io.tarantool.core.state.State<E extends Event> {
  + void handle(E)
}

interface io.tarantool.core.state.StateMachine<E extends Event> {
  + void handle(E)
}

abstract class io.tarantool.core.state.AbstractDrainLoopMachine<E extends Event> {
  - controlEvents: Queue<E> {readOnly}
  - events: Queue<E> {readOnly}
  - wip: AtomicInteger {readOnly}
  - safelyProcess(e: E): void
  # {abstract} processEvent(E): void
  # {abstract} onHandleError(Throwable): void
  + handle(E): void
}

